{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "menu-app-template/tree.schema.json",
  "title": "Menu tree",
  "description": "One file describing every screen of a menu-tree app. Structural rules a schema cannot express (ids unique, every next resolves, every node reachable from root) are checked by tools/menutree.py validate. See SPEC.md.",
  "type": "object",
  "required": ["schemaVersion", "app", "root", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "app": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Display name of the app." },
        "subject": { "type": "string", "description": "What the content is about. Informational." },
        "description": { "type": "string", "description": "One-sentence summary. Informational." },
        "highlightFont": { "enum": ["default", "monospaced"], "default": "default",
                           "description": "Font for highlight blocks: monospaced suits code/commands, default suits math/prose." }
      }
    },
    "root": { "$ref": "#/$defs/id", "description": "Id of the home screen." },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S",
              "description": "Plain text. No markup. \\n is a line break." },
    "node": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "anyOf": [
        { "required": ["highlight"] }, { "required": ["body"] },
        { "required": ["steps"] }, { "required": ["choices"] }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text", "description": "Screen heading." },
        "tag": { "$ref": "#/$defs/text", "description": "Short section label (nav bar / breadcrumb)." },
        "highlight": { "$ref": "#/$defs/text", "description": "Key facts block: equations, commands, values. Shown first, emphasized." },
        "body": { "$ref": "#/$defs/text", "description": "Explanatory text." },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" },
                   "description": "Ordered process, rendered as a numbered list." },
        "caution": { "$ref": "#/$defs/text", "description": "The mistake to avoid. Rendered as a warning." },
        "choices": {
          "type": "array", "minItems": 1,
          "description": "Buttons to other screens, in order. A node without choices is an end screen.",
          "items": {
            "type": "object",
            "required": ["label", "next"],
            "additionalProperties": false,
            "properties": {
              "label": { "$ref": "#/$defs/text" },
              "next": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    }
  }
}
